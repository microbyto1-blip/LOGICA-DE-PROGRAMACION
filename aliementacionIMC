import java.util.Scanner;

public class CalculadoraIMC {

    public static void main(String[] args) {

        Scanner entrada = new Scanner(System.in);

        String nombre;
        String genero;
        double peso;
        double altura;
        double imc;

        int opcion = 1;

        // CICLO
        while (opcion == 1) {

            System.out.println("=================================");
            System.out.println("     CALCULADORA DE IMC");
            System.out.println("=================================");

            System.out.print("Nombre: ");
            nombre = entrada.nextLine();

            System.out.print("Genero (M/F): ");
            genero = entrada.nextLine();

            System.out.print("Peso en kg: ");
            peso = entrada.nextDouble();

            System.out.print("Altura en metros: ");
            altura = entrada.nextDouble();

            // CALCULO DEL IMC
            imc = peso / (altura * altura);

            System.out.println("\n=================================");
            System.out.println("RESULTADOS");
            System.out.println("=================================");
            System.out.println("Nombre: " + nombre);
            System.out.println("Genero: " + genero);
            System.out.printf("IMC: %.2f%n", imc);

            int categoria;

            // IF / ELSE
            if (imc < 18.5) {
                categoria = 1;
            } 
            else if (imc < 25) {
                categoria = 2;
            } 
            else if (imc < 30) {
                categoria = 3;
            } 
            else if (imc < 35) {
                categoria = 4;
            } 
            else if (imc < 40) {
                categoria = 5;
            } 
            else {
                categoria = 6;
            }

            // SWITCH-CASE
            switch (categoria) {

                case 1:
                    System.out.println("Clasificacion: BAJO PESO");
                    System.out.println("Accion 1: Mejorar la alimentacion.");
                    System.out.println("Accion 2: Realizar actividad fisica moderada.");
                    break;

                case 2:
                    System.out.println("Clasificacion: PESO NORMAL");
                    System.out.println("Accion 1: Mantener una alimentacion equilibrada.");
                    System.out.println("Accion 2: Realizar ejercicio regularmente.");
                    break;

                case 3:
                    System.out.println("Clasificacion: SOBREPESO");
                    System.out.println("Accion 1: Aumentar la actividad fisica.");
                    System.out.println("Accion 2: Mantener una alimentacion equilibrada y buena hidratacion.");
                    break;

                case 4:
                    System.out.println("Clasificacion: OBESIDAD GRADO I");
                    System.out.println("Accion 1: Realizar ejercicio de forma progresiva.");
                    System.out.println("Accion 2: Mejorar la alimentacion y mantener buena hidratacion.");
                    break;

                case 5:
                    System.out.println("Clasificacion: OBESIDAD GRADO II");
                    System.out.println("Accion 1: Realizar actividad fisica de manera progresiva.");
                    System.out.println("Accion 2: Buscar orientacion de un profesional de la salud.");
                    break;

                case 6:
                    System.out.println("Clasificacion: OBESIDAD GRADO III");
                    System.out.println("Accion 1: Buscar orientacion medica y nutricional.");
                    System.out.println("Accion 2: Iniciar actividad fisica de manera progresiva y supervisada.");
                    break;
            }

            System.out.println("\n¿Desea registrar otra persona?");
            System.out.println("1. Si");
            System.out.println("2. No");
            System.out.print("Opcion: ");

            opcion = entrada.nextInt();
            entrada.nextLine();

            System.out.println();
        }

        System.out.println("Programa finalizado.");
        entrada.close();
    }
}